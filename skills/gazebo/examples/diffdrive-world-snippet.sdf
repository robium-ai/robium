<?xml version="1.0" ?>
<!--
  status: unverified
  Adapted from two upstream sources, both fetched directly via raw GitHub
  `curl` on 2026-07-10:
    - gazebosim/docs, harmonic/tutorials/moving_robot/moving_robot.sdf
      (world plugins, ground plane, light, chassis/wheel/caster link and
      joint layout, the DiffDrive plugin block)
    - gazebosim/docs, harmonic/sensors.md (the IMU sensor plugin/tags) and
      the lidar tags from sdformat's lidar.sdf schema (using the current
      preferred <lidar> tag rather than the tutorial's legacy <ray> tag;
      see ../references/sensors.md)

  Deviations from those sources, made deliberately and listed here rather
  than silently drifting from upstream:
    - The canonical link is named "base_link" (upstream's tutorial uses
      "chassis") and the lidar/IMU sensors are mounted on it at zero offset
      (upstream mounts the lidar on a separate offset "lidar_frame"). This
      keeps the snippet's only body frame identical to what the DiffDrive
      plugin's <child_frame_id> below publishes, so every frame in this file
      and in ../examples/ros-gz-bridge-config.yaml resolves to "base_link"
      without an extra static transform. A real robot's lidar/camera is
      normally offset from base_link via its own frame (see
      ../references/worlds-and-models.md's frame section) with a
      robot_state_publisher-published static transform bridging the two;
      that TF piece is the `ros2` skill's territory and is intentionally
      left out of this minimal snippet.
    - <topic>, <odom_topic>, <tf_topic>, <frame_id>, and <child_frame_id> are
      all set explicitly on the DiffDrive plugin (upstream's moving_robot.sdf
      only sets <topic>) so this world's gz topics are flat ("/cmd_vel",
      "/odom", "/tf") instead of model-scoped, matching
      ../examples/ros-gz-bridge-config.yaml and what nav2's example params
      expect (odom_frame_id "odom", base_frame_id "base_link",
      odom_topic "/odom"); see ../../nav2/examples/nav2-params-diffdrive.yaml.
      The leading slash on every explicitly-set <topic>/<odom_topic>/
      <tf_topic> (and the sensors' <topic> tags below) matches the
      convention gz-sim's own test worlds use for explicit topics; see
      gz-sim's test/worlds/diff_drive_custom_topics.sdf
      (<topic>/model/foo/cmdvel</topic>, <odom_topic>/model/bar/odom</odom_topic>),
      fetched directly via raw GitHub on 2026-07-10. gz-transport topic
      matching is exact-string (TopicUtils::AsValidTopic() never inserts a
      leading slash for an explicitly-set topic), so this must match
      ../examples/ros-gz-bridge-config.yaml's gz_topic_name values
      character-for-character or the bridge silently fails to connect.
    - Dimensions, mass, and wheel geometry are simplified round numbers, not
      copied from either upstream file.
    - The wall/contact-sensor and keyboard-teleop plugins from the
      moving_robot.sdf tutorial are omitted; out of scope for this snippet.

  Not yet run against a live `gz sim`; verify it loads before using it in a
  real project.
-->
<sdf version="1.9">
  <world name="diffdrive_demo">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands" />
    <!-- required for the gpu_lidar sensor below -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- required for the imu sensor below -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu" />

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="diffbot" canonical_link="base_link">
      <pose relative_to="world">0 0 0.1 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.1</iyy><iyz>0</iyz>
            <izz>0.15</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box><size>0.4 0.3 0.15</size></box>
          </geometry>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.4 0.3 0.15</size></box>
          </geometry>
        </collision>

        <!-- lidar mounted at base_link's own origin; see the deviation
             note above on why there is no separate offset frame here -->
        <sensor name="gpu_lidar" type="gpu_lidar">
          <topic>/scan</topic>
          <update_rate>10</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.10</min>
              <max>12.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </lidar>
          <always_on>1</always_on>
          <visualize>true</visualize>
        </sensor>

        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>100</update_rate>
          <visualize>true</visualize>
          <topic>/imu</topic>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose relative_to="base_link">0 0.175 -0.02 -1.5707 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        </collision>
      </link>

      <link name="right_wheel">
        <pose relative_to="base_link">0 -0.175 -0.02 -1.5707 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        </collision>
      </link>

      <frame name="caster_frame" attached_to="base_link">
        <pose>-0.15 0 -0.07 0 0 0</pose>
      </frame>
      <link name="caster">
        <pose relative_to="caster_frame" />
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0005</iyy><iyz>0</iyz><izz>0.0005</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
        </collision>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <pose relative_to="left_wheel" />
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <pose relative_to="right_wheel" />
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <joint name="caster_wheel" type="ball">
        <parent>base_link</parent>
        <child>caster</child>
      </joint>

      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.35</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <max_linear_velocity>0.6</max_linear_velocity>
        <min_linear_velocity>-0.6</min_linear_velocity>
        <max_angular_velocity>1.5</max_angular_velocity>
        <min_angular_velocity>-1.5</min_angular_velocity>
      </plugin>
    </model>
  </world>
</sdf>
