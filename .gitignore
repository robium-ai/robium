# Python / uv
.venv/
__pycache__/
*.pyc
*.egg-info/
.uv-cache/

# Superpowers scratch
.superpowers/

# Claude worktrees
.claude/worktrees/

# ROS 2 / colcon workspaces inside apps
**/build/
**/install/
**/log/

# ML runs and data (apps keep small configs in git, not artifacts)
**/outputs/
**/wandb/
**/checkpoints/
*.ckpt
*.safetensors

# Recordings
*.mcap
*.db3
*.rrd

# OS noise
.DS_Store

# App bag recordings (keep the .gitkeep placeholder)
apps/*/bags/*
!apps/*/bags/.gitkeep

# Node (cli/ and website/ subprojects; nested .gitignores also cover these)
node_modules/
dist/
.astro/

# Secrets — managed in Doppler; never commit real values (template is allowed)
.env
.env.*
!.env.template
.robium/

# Learning observations are disposable local working state. README documents
# the schema; absorbed guidance lives in skills and their references.
learnings/observations/*.md
!learnings/observations/README.md

# Legacy dated learnings: local leftovers to fold into an observation or skill.
learnings/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]*.md
