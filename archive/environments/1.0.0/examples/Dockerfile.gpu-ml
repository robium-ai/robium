# status: unverified
# source: https://hub.docker.com/r/nvidia/cuda/tags (base image tag) and
#         https://docs.astral.sh/uv/guides/integration/docker/ (multi-stage uv pattern)
#
# Example: GPU-enabled, multi-stage uv build for an ML training/inference
# container. Requires the NVIDIA Container Toolkit on the host (Linux only)
# and `docker run --rm --gpus all <image>` — see
# skills/environments/references/gpu-and-remote.md. Re-verify the CUDA base
# tag against hub.docker.com/r/nvidia/cuda and match it to the target host's
# driver-supported CUDA version (check with `nvidia-smi` on that host) before
# using in a real project.

FROM nvidia/cuda:13.3.0-cudnn-runtime-ubuntu24.04 AS builder

# This base image is CUDA/cuDNN runtime only — no Python 3. Install it before
# the first uv sync (UV_PYTHON_DOWNLOADS=0 below means uv will not fetch one).
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 \
    && rm -rf /var/lib/apt/lists/*

# Install uv by copying the binary from the official distroless image.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

# Resolve and install dependencies first (cached separately from app code).
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project

COPY . /app
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked

FROM nvidia/cuda:13.3.0-cudnn-runtime-ubuntu24.04

# Same Python 3 install as the builder stage — the copied .venv's interpreter
# symlink must resolve to a real python3 here too (matching builder/runtime
# base images, per skills/environments/references/docker-patterns.md).
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1000 robium \
 && useradd --system --gid 1000 --uid 1000 --create-home robium

# Copy the resolved venv and app code, not uv's cache or build tooling.
COPY --from=builder --chown=robium:robium /app /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

USER robium
WORKDIR /app

# Run with: docker run --rm --gpus all <image>
CMD ["python", "train.py"]
