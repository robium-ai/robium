# Which env vars robium needs — NAMES ONLY. Never put real values here.
# The source of truth is Doppler (project: robium, config: dev). Load them with
# `doppler run -- <command>`; see docs/secrets.md.

NPM_TOKEN=        # npm auth token — publishing the robium-ai package (cli/)
HF_TOKEN=         # HuggingFace token — HF datasets/models/Spaces (apps/)
RUNPOD_API_KEY=   # RunPod REST API — isaac-lab go2 GPU pods
NGC_API_KEY=      # NVIDIA NGC — pulling nvcr.io/nvidia/isaac-lab (docker user is $oauthtoken)

GITHUB_TOKEN=     # fine-grained PAT (robium-ai org) — git/gh over HTTPS anywhere
GCP_SA_KEY=       # service-account JSON (robium-prod) — deploys without gcloud login
